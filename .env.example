# Obtain both values from your project's Connect dialog / API settings.
# Only the publishable (or legacy anon) key belongs here. NEVER use a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Leave false for real accounts; true explicitly enables the isolated localStorage demo.
NEXT_PUBLIC_DEMO_MODE=false
